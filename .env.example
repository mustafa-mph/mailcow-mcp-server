# Copy to .env and fill in.  Never commit .env.

# ---------- Mailcow API (required) ----------
# Create the key in Mailcow: System > Configuration > Access > API, and allow this server's IP.
MAILCOW_API_URL=https://mail.example.com
MAILCOW_API_KEY=
# read-write (default) or read-only. read-only hides every tool that changes something.
MAILCOW_API_ACCESS=read-write
# MAILCOW_API_TIMEOUT_MS=20000

# ---------- Server (required) ----------
# Public HTTPS URL clients connect to (your reverse proxy points this at port 3901)
PUBLIC_BASE_URL=https://mcp-admin.example.com
# Encrypts saved sign-ins. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# ---------- Admin logins (recommended) ----------
# Local admin usernames + passwords for the sign-in page (not mailboxes). Do not edit by hand -
# create or change one with:   ./set-admin-password.sh <username>
# (stores only a scrypt hash, e.g. ADMIN_USERS=admin:scrypt.16384.8.1.<salt>.<hash>)
ADMIN_USERS=
# false = only ADMIN_USERS can sign in (mailbox sign-in turned off completely)
MAILBOX_SIGNIN=true

# ---------- Who can do what (mailbox sign-in) ----------
# Signed-in mailboxes that get the admin tools (comma-separated)
ADMIN_EMAILS=admin@example.com
# true = only ADMIN_EMAILS may sign in; false = everyone may sign in and gets self-service tools for their own mailbox
ADMINS_ONLY=false
# Only allow addresses @this domain to sign in (empty = any mailbox on the server)
USER_MAIL_DOMAIN=example.com
# Optional static admin token for headless clients (Authorization: Bearer ...). Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---------- Sign-in (optional) ----------
# Passwords are checked with an IMAP login. Defaults to the host of MAILCOW_API_URL, port 993, TLS.
# USER_IMAP_HOST=mail.example.com
# USER_IMAP_PORT=993
# USER_IMAP_SECURE=true
BRAND_NAME=Example Mail Admin

# ---------- Advanced ----------
# PORT=3901
# SESSION_FILE=/data/sessions.json
# TRUST_PROXY_HOPS=1
